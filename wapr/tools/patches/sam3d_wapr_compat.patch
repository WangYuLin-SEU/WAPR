+# Texels the short optimizer never writes stay black inside the chart.
+# The outside-only inpaint does not see them, and mipmaps then pick up the gutter.
+# 短优化没写到的纹素会留在色块里面，变成黑色。
+# 只补色块外面的修补看不到它们，mipmap 还会采到色块之间的黑边。
+BAKE_HOLE_SUM = 48
+BAKE_PAD_PX = 8
+
+
+def fill_unbaked_holes(texture, uvs, faces, dark_sum=BAKE_HOLE_SUM, pad_px=BAKE_PAD_PX):
+    """Fill black texels inside UV charts, then bleed color a few pixels into the gutter.
+
+    补上 UV 色块内部的黑纹素，再把颜色向外渗几个像素，盖住色块之间的黑边。
+    """
+    from scipy.spatial import cKDTree
+
+    image = np.asarray(texture)
+    if image.ndim != 3 or image.shape[2] < 3:
+        return texture
+    image = np.ascontiguousarray(image[:, :, :3]).copy()
+    height, width = image.shape[:2]
+    uv = np.asarray(uvs, dtype=np.float64).reshape(-1, 2)
+    triangles = np.asarray(faces, dtype=np.int32).reshape(-1, 3)
+    coverage = np.zeros((height, width), np.uint8)
+    pixels = np.stack([
+        uv[:, 0] * (width - 1),
+        (1.0 - uv[:, 1]) * (height - 1),
+    ], axis=1)
+    for face in triangles:
+        polygon = np.rint(pixels[face]).astype(np.int32)
+        if polygon[:, 0].max() < 0 or polygon[:, 1].max() < 0 or polygon[:, 0].min() >= width or polygon[:, 1].min() >= height:
+            continue
+        cv2.fillConvexPoly(coverage, polygon, 255)
+    colored = (coverage > 0) & (image.sum(axis=2) >= int(dark_sum))
+    if not np.any(colored):
+        return image
+    kernel = cv2.getStructuringElement(
+        cv2.MORPH_ELLIPSE, (int(pad_px) * 2 + 1, int(pad_px) * 2 + 1),
+    )
+    grown = cv2.dilate(colored.astype(np.uint8) * 255, kernel)
+    holes = ((coverage > 0) & np.logical_not(colored)) | ((grown > 0) & (coverage == 0))
+    if not np.any(holes):
+        return image
+    source_y, source_x = np.where(colored)
+    tree = cKDTree(np.stack([source_x, source_y], axis=1))
+    hole_y, hole_x = np.where(holes)
+    _dist, nearest = tree.query(np.stack([hole_x, hole_y], axis=1), k=1)
+    image[hole_y, hole_x] = image[source_y[nearest], source_x[nearest]]
+    return image
+
