+def depth_edge(depth, atol=None, rtol=None, kernel_size=3, mask=None):
+    """Mark pixels whose depth jumps relative to a neighbor.
+
+    标出深度相对邻域跳变的像素。
+    """
+    depth = np.asarray(depth, dtype=np.float64)
+    if depth.ndim == 3:
+        depth = depth[..., 0]
+    valid = np.isfinite(depth)
+    if mask is not None:
+        valid = valid & np.asarray(mask, dtype=bool)
+    edge = np.zeros(depth.shape, dtype=bool)
+    radius = max(int(kernel_size) // 2, 1)
+    for dy in range(-radius, radius + 1):
+        for dx in range(-radius, radius + 1):
+            if dy == 0 and dx == 0:
+                continue
+            shifted = np.roll(np.roll(depth, dy, axis=0), dx, axis=1)
+            shifted_valid = np.roll(np.roll(valid, dy, axis=0), dx, axis=1)
+            diff = np.abs(depth - shifted)
+            limit = 0.0
+            if atol is not None:
+                limit = limit + float(atol)
+            if rtol is not None:
+                limit = limit + float(rtol) * np.maximum(np.abs(depth), np.abs(shifted))
+            edge |= valid & shifted_valid & (diff > limit)
+    return edge
 
