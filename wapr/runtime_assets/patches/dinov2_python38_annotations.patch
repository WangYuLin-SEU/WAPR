+                q, k, v, attn_mask=None, dropout_p=self.attn_drop if self.training else 0, is_causal=is_causal
+            )
+        else:
+            # Equivalent attention on older Torch; preserve scale, dropout and causality.
+            # 旧 Torch 使用等价注意力，保留缩放、dropout 与因果掩码规则。
+            attention = (q * self.scale) @ k.transpose(-2, -1)
+            if is_causal:
+                causal_mask = torch.ones((N, N), device=q.device, dtype=torch.bool).tril()
+                attention = attention.masked_fill(~causal_mask, float("-inf"))
+            attention = attention.softmax(dim=-1)
+            attention = nn.functional.dropout(attention, p=self.attn_drop if self.training else 0, training=self.training)
+            x = attention @ v
         x = x.transpose(1, 2).contiguous().view(B, N, C)
         x = self.proj_drop(self.proj(x))
         return x
